{
 "name": "live_portrait",
 "label": "Live portrait: a still face moves, talks and makes expressions, driven by a video (LivePortrait)",
 "license": "LivePortrait: MIT (KwaiVGI); ComfyUI-LivePortraitKJ: MIT (kijai); face detector BlazeFace (Apache-2.0) via face_alignment (BSD-3); graph AGPL-3.0 (AMAL's own, from the packs' node sources); the face landmarks run as ONNX on the CPU (a pickled PyTorch landmark file does not load under PyTorch 2.6's safe loading)",
 "sources": {
  "pack": "kijai/ComfyUI-LivePortraitKJ@4d9dc62 (nodes.py: DownloadAndLoadLivePortraitModels, LivePortraitLoadFaceAlignmentCropper, LivePortraitCropper, LivePortraitProcess, LivePortraitComposite)",
  "comfyui": "comfyanonymous/ComfyUI@63e5bf594339f676b4b15e072529873e3448409e (comfy_extras/nodes_video.py LoadVideo, Video Slice, GetVideoComponents, SaveWEBM; nodes.py LoadImage)",
  "driving": "KwaiVGI/LivePortrait@9b294b3 assets/examples/driving (MIT)"
 },
 "about": "One picture of a face (a person, a character, a painting; subject: animal for a pet) and a driving video of a face: the picture makes the same head turns, blinks, mouth and expressions, at the picture's own size and look. driving_video is a file in the job (anyone filmed facing the camera) or one of the presets: talking, laughing, wink_smile, expressive, glance_smile. motion_mode: relative (default), single_frame, off. Silent video (WebM). Fast: a few seconds of work for 8 seconds of video on an 8 GB card.",
 "packs": [
  {
   "dir": "ComfyUI-LivePortraitKJ",
   "url": "https://github.com/kijai/ComfyUI-LivePortraitKJ",
   "commit": "4d9dc6205b793ffd0fb319816136d9b8c0dbfdff",
   "pip": [
    {
     "import": "cv2",
     "package": "opencv-python-headless"
    },
    {
     "import": "pykalman",
     "package": "pykalman"
    },
    {
     "import": "numba",
     "package": "numba"
    },
    {
     "import": "skimage",
     "package": "scikit-image"
    },
    {
     "import": "yaml",
     "package": "pyyaml"
    },
    {
     "import": "onnxruntime",
     "package": "onnxruntime"
    }
   ],
   "patches": [
    {
     "file": "face_alignment/api.py",
     "find": "face_detector_module = importlib.import_module('.face_alignment.detection.' + face_detector, package=package_directory_name)",
     "replace": "face_detector_module = importlib.import_module('.detection.' + face_detector, package=__package__)"
    }
   ]
  }
 ],
 "nodes": {
  "image": "3",
  "save": "10"
 },
 "api": {
