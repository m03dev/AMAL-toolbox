   "inputs": {
    "precision": "auto",
    "mode": "human"
   }
  },
  "2": {
   "class_type": "LivePortraitLoadFaceAlignmentCropper",
   "inputs": {
    "face_detector": "blazeface_back_camera",
    "landmarkrunner_device": "CPU",
    "face_detector_device": "cuda",
    "face_detector_dtype": "fp16",
    "keep_model_loaded": false
   }
  },
  "3": {
   "class_type": "LoadImage",
   "inputs": {
    "image": ""
   }
  },
  "4": {
   "class_type": "LoadVideo",
   "inputs": {
    "file": ""
   }
  },
  "5": {
   "class_type": "Video Slice",
   "inputs": {
    "video": [
     "4",
     0
    ],
    "start_time": 0.0,
    "duration": 8.0,
    "strict_duration": false
   }
  },
  "6": {
   "class_type": "GetVideoComponents",
   "inputs": {
    "video": [
     "5",
     0
    ]
   }
  },
  "7": {
   "class_type": "LivePortraitCropper",
   "inputs": {
    "pipeline": [
     "1",
     0
    ],
    "cropper": [
     "2",
     0
    ],
    "source_image": [
     "3",
     0
    ],
    "dsize": 512,
    "scale": 2.3,
    "vx_ratio": 0.0,
    "vy_ratio": -0.125,
    "face_index": 0,
    "face_index_order": "large-small",
    "rotate": true
   }
  },
  "8": {
   "class_type": "LivePortraitProcess",
   "inputs": {
    "pipeline": [
     "1",
     0
    ],
    "crop_info": [
     "7",
     1
    ],
    "source_image": [
     "3",
     0
    ],
    "driving_images": [
     "6",
     0
    ],
    "lip_zero": false,
    "lip_zero_threshold": 0.03,
    "stitching": true,
    "delta_multiplier": 1.0,
    "mismatch_method": "constant",
    "relative_motion_mode": "relative",
    "driving_smooth_observation_variance": 3e-06,
    "expression_friendly": false,
    "expression_friendly_multiplier": 1.0
   }
  },
  "9": {
   "class_type": "LivePortraitComposite",
   "inputs": {
    "source_image": [
     "3",
     0
    ],
    "cropped_image": [
     "8",
     0
    ],
    "liveportrait_out": [
     "8",
     1
    ]
   }
  },
  "10": {
   "class_type": "SaveWEBM",
   "inputs": {
    "images": [
     "9",
     0
    ],
    "filename_prefix": "amal_video/live_portrait",
    "codec": "vp9",
    "fps": [
     "6",
     2
    ],
    "crf": 16.0
   }
  }
 },
