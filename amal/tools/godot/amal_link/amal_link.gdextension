[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = false

[libraries]
macos.debug = "bin/libamal_godot.dylib"
macos.release = "bin/libamal_godot.dylib"
windows.debug.x86_64 = "bin/amal_godot.dll"
windows.release.x86_64 = "bin/amal_godot.dll"
linux.debug.x86_64 = "bin/libamal_godot.so"
linux.release.x86_64 = "bin/libamal_godot.so"
