{
  "name": "vectorize",
  "does": "Trace a picture (a logo idea from the picture model, a drawing) into a clean SVG",
  "when": ["vector", "svg", "trace", "logo", "picture to svg"],
  "args": {
    "picture": {"type": "string", "description": "the .png/.jpg"},
    "out": {"type": "string", "description": "the .svg to write"},
    "mono": {"type": "boolean", "description": "one colour (best for marks)", "default": false}
  },
  "required": ["picture", "out"],
  "run": "{python} {root}/capabilities/logo/scripts/vectorize.py {picture} -o {out} [--mono{mono}]",
  "outputs": ["{out}"],
  "timeout_s": 300
}
